rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // siteContent/current
    //   importantDates: list (required, max 30)
    //   announcements: list (required, max 40)
    //   updatedAt: timestamp (required)
    // quickLinks/current
    //   links: map of six service settings (HTTPS URL, status, note)
    //   updatedAt: timestamp (required)
    // linkStats/{serviceId}
    //   clicks: integer aggregate (no user identity stored)
    //   updatedAt: timestamp (required)
    // profiles/{uid}
    //   uid: string (required, immutable, document owner)
    //   displayName: string (required, 2-100 chars)
    //   phone: string (required, 7-24 chars)
    //   email: string (required, immutable, authenticated @itqshhb.edu.bn email)
    //   createdAt: timestamp (required, immutable)
    //   updatedAt: timestamp (required)

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'azharsuhaili19@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isEduEmail(email) {
      return email is string && email.matches('^[A-Za-z0-9._%+\\-]+@itqshhb\\.edu\\.bn$');
    }

    function isVerifiedEducator() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && isEduEmail(request.auth.token.email);
    }

    function isServiceId(serviceId) {
      return serviceId in ['disiplin', 'hafazan', 'akademik', 'aktiviti', 'kalendar', 'bpp'];
    }

    function validQuickLink(item) {
      return item is map
        && item.keys().hasAll(['url', 'status', 'note'])
        && item.keys().hasOnly(['url', 'status', 'note'])
        && item.url is string
        && item.url.size() <= 500
        && (item.url == '' || item.url.matches('^https://.+$'))
        && item.status in ['active', 'maintenance', 'closed']
        && (item.status != 'active' || item.url != '')
        && item.note is string
        && item.note.size() <= 120;
    }

    function validQuickLinks(data) {
      return data.keys().hasAll(['links', 'updatedAt'])
        && data.keys().hasOnly(['links', 'updatedAt'])
        && data.links is map
        && data.links.keys().hasAll(['disiplin', 'hafazan', 'akademik', 'aktiviti', 'kalendar', 'bpp'])
        && data.links.keys().hasOnly(['disiplin', 'hafazan', 'akademik', 'aktiviti', 'kalendar', 'bpp'])
        && validQuickLink(data.links.disiplin)
        && validQuickLink(data.links.hafazan)
        && validQuickLink(data.links.akademik)
        && validQuickLink(data.links.aktiviti)
        && validQuickLink(data.links.kalendar)
        && validQuickLink(data.links.bpp)
        && data.updatedAt == request.time;
    }

    function validClickStats(data) {
      return data.keys().hasAll(['clicks', 'updatedAt'])
        && data.keys().hasOnly(['clicks', 'updatedAt'])
        && data.clicks is int
        && data.updatedAt == request.time;
    }

    function validContent(data) {
      return data.keys().hasAll(['importantDates', 'announcements', 'updatedAt'])
        && data.keys().hasOnly(['importantDates', 'announcements', 'updatedAt'])
        && data.importantDates is list
        && data.importantDates.size() <= 30
        && data.announcements is list
        && data.announcements.size() <= 40
        && data.updatedAt is timestamp;
    }

    function validProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'phone', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'phone', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 100
        && data.phone is string
        && data.phone.size() >= 7
        && data.phone.size() <= 24
        && data.email is string
        && data.email == request.auth.token.email
        && isEduEmail(data.email)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /siteContent/current {
      allow get: if isVerifiedEducator() || isAdmin();
      allow list: if false;
      allow create, update: if isAdmin() && validContent(request.resource.data);
      allow delete: if false;
    }

    match /quickLinks/current {
      allow get: if isVerifiedEducator() || isAdmin();
      allow list, delete: if false;
      allow create, update: if isAdmin() && validQuickLinks(request.resource.data);
    }

    match /linkStats/{serviceId} {
      allow get: if isAdmin() && isServiceId(serviceId);
      allow list, delete: if false;
      allow create: if isServiceId(serviceId)
        && (isVerifiedEducator() || isAdmin())
        && validClickStats(request.resource.data)
        && request.resource.data.clicks == 1;
      allow update: if isServiceId(serviceId)
        && (isVerifiedEducator() || isAdmin())
        && validClickStats(request.resource.data)
        && resource.data.clicks is int
        && request.resource.data.clicks == resource.data.clicks + 1;
    }

    match /profiles/{uid} {
      allow get: if isVerifiedEducator() && request.auth.uid == uid;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'password'
        && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isVerifiedEducator()
        && request.auth.uid == uid
        && validProfile(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
